# =============================================================
#  VS-WP — ignore rules
#
#  This repo tracks ONLY: the child theme, docs, source
#  reference HTML, and Elementor JSON exports.
#  WordPress itself lives in LocalWP, outside this repo.
# =============================================================

# ── Secrets and configuration ────────────────────────────────
wp-config.php
wp-config-local.php
.env
.env.*
*.pem
*.key
*.p12
auth.json

# ── WordPress core (defensive: in case the repo is ever
#    dropped inside a WP install) ────────────────────────────
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/license.txt
/readme.html
/xmlrpc.php

# ── wp-content we never version ──────────────────────────────
uploads/
upgrade/
upgrade-temp-backup/
cache/
wflogs/
languages/
**/wp-content/plugins/
**/wp-content/mu-plugins/
backup*/
*backup*/

# ── Themes: track ONLY our child theme ───────────────────────
# Parent theme (Hello Elementor) is installed via WP, not versioned.
themes/*
!themes/hello-elementor-child/

# ── Database dumps ───────────────────────────────────────────
*.sql
*.sql.gz
*.sql.zip
*.mysql

# ── Large binaries (keep the repo light) ─────────────────────
# Source reference images/video belong in WP Media, not git.
source/**/*.mp4
source/**/*.mov
source/**/*.zip
source/**/*.psd
source/**/*.ai

# ── Build / dependency artefacts ─────────────────────────────
node_modules/
vendor/
.sass-cache/
*.map
package-lock.json.bak

# ── Editor and tooling ───────────────────────────────────────
.vscode/*
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
.claude/settings.local.json

# ── OS cruft ─────────────────────────────────────────────────
# desktop.ini is generated by OneDrive on every synced folder.
desktop.ini
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# ── Logs and temp ────────────────────────────────────────────
*.log
debug.log
error_log
*.tmp
*.bak
*~
